# Local development only. Replace the password in BOTH variables before non-local use.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://apbackup:local-development-only@127.0.0.1:5549/apbackup_dev
PORT=4320
AUTH_BASE_URL=http://127.0.0.1:4320
# Server-only random secret, at least 32 characters; never use a shared example value.
AUTH_SECRET=
# 32 random bytes in base64; keep its independent backup outside the catalog.
VAULT_KEY_BASE64=
VAULT_KEY_REFERENCE=local-primary-v1
# Coordinator is opt-in; this does not activate any plan or destination.
COORDINATOR_SCHEDULES=disabled
# Linux host only, private file with identity and explicit resource allowlist.
AGENT_CONFIG=/etc/apbackup/agent.json
# Exact, comma-separated PostgreSQL origins approved for discovery and scoped agent access.
# Empty denies access. Match the host entered in the console and the agent allowlist.
POSTGRES_ALLOWED_HOSTS=
DOKPLOY_ALLOWED_ORIGINS=
# Production Compose only. Generate actual values with scripts/prepare-install.mjs on Linux.
CATALOG_DATABASE_URL=
ADMIN_DATABASE_URL=
WEB_PORT=4320
AGENT_CONFIG_DIRECTORY=/etc/apbackup
AGENT_STATE_DIRECTORY=/var/lib/apbackup
